# Telegram bot token from @BotFather. Secret; never expose it in frontend settings.
TELEGRAM_BOT_TOKEN=123456789:replace-with-botfather-token
# Username belonging to the token, without @.
TELEGRAM_BOT_USERNAME=YourVerificationBot

# Exact public HTTPS origin serving the verification UI, no path or trailing URL parameters.
PUBLIC_BASE_URL=https://verify.example.com
# At least 32 bytes of cryptographically random text. Example generator: openssl rand -base64 48
VERIFICATION_SECRET=replace-with-at-least-32-random-bytes
# Ticket lifetime in seconds (60–900); default is 180.
VERIFICATION_TTL=180
# Cloudflare Turnstile server-side secret key.
TURNSTILE_SECRET_KEY=replace-with-turnstile-secret-key
# Public Cloudflare Turnstile site key. This is visible to browsers.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace-with-turnstile-site-key

# Telegram username also appears in browser links; no @.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=YourVerificationBot
# Host port published by Docker Compose.
FRONTEND_PORT=3000
# Public URL consumed by Telegram and Cloudflare. Keep in sync with PUBLIC_BASE_URL.
BACKEND_BASE_URL=http://backend:3000
# Host bind address; keep loopback when Caddy/Nginx runs on this server.
FRONTEND_BIND_ADDRESS=127.0.0.1
# Service port for direct bare-metal runs. Compose overrides both services' container ports.
PORT=3000
