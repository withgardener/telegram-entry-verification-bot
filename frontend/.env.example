# Local development backend address. Compose overrides this with its private service URL.
BACKEND_BASE_URL=http://127.0.0.1:3001

# Local development origin. Use your real HTTPS origin in production.
PUBLIC_BASE_URL=http://localhost:3000

# Public Cloudflare Turnstile widget key; safe to expose in the browser.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace-with-turnstile-site-key

# Public Telegram bot username, without the leading @.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=YourVerificationBot

# Frontend dev server port; the bot backend should use 3001 in its .env.
PORT=3000
