{
  "name": "telegram-entry-verification-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/app.js",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch app.ts",
    "start": "node dist/app.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint app.ts src test eslint.config.mjs",
    "test": "npm run build && node --test dist/test/verification.test.js && node --test dist/test/telegram-api.test.js && node --test dist/test/http-smoke.test.js",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@grammyjs/fluent": "1.0.3",
    "@moebius/fluent": "1.1.0",
    "@koa/router": "15.7.0",
    "dotenv": "18.0.3",
    "grammy": "1.46.0",
    "koa": "3.2.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/koa": "3.0.3",
    "@types/node": "24.13.6",
    "eslint": "10.11.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
